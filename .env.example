# --- Runtime -----------------------------------------------------------------
# SIMULATION_ONLY | MOCK_VISION | ROBOFLOW | DATASET_GENERATION
VITE_RUNTIME_MODE=MOCK_VISION

VITE_DEBUG_LOGGING=false

# --- Roboflow credentials ----------------------------------------------------
# Copy this file to `.env.local` and fill it in. Never commit real keys.
# https://app.roboflow.com/settings/api
#
# PREFERRED: no VITE_ prefix, so Vite never inlines it into the client bundle.
# The dev server proxy attaches it to every upstream Roboflow request.
ROBOFLOW_API_KEY=
# Upstream the proxy forwards to. Point it at a Dedicated Deployment if you have one.
ROBOFLOW_UPSTREAM=https://serverless.roboflow.com

# Only needed for the DIRECT / DEDICATED / SELF-HOSTED runtimes, which call
# Roboflow from the browser. This value IS bundled into the client.
VITE_ROBOFLOW_API_KEY=

# Workflow transport (default, preferred): the inspection recipe lives in
# Roboflow. Both values are on the "Deploy Workflow" panel in the editor.
VITE_ROBOFLOW_WORKSPACE=
VITE_ROBOFLOW_WORKFLOW_ID=
# Name of the image input declared in the Workflow.
VITE_ROBOFLOW_WORKFLOW_IMAGE_INPUT=image

# Model transport (alternative): a single trained model, as `project/version`.
VITE_ROBOFLOW_MODEL_ID=

# --- Where inference runs ----------------------------------------------------
# PROXY | LOCAL | DEDICATED | SERVERLESS. Switchable live from the Roboflow HMI
# panel. PROXY is the default: Roboflow's cloud endpoints send no CORS headers,
# so a browser cannot call them directly.
VITE_ROBOFLOW_RUNTIME=PROXY
# WORKFLOW | MODEL
VITE_ROBOFLOW_TRANSPORT=WORKFLOW

# Dedicated Deployment endpoint, e.g. https://<id>.roboflow.cloud
VITE_ROBOFLOW_DEDICATED_URL=
# Self-hosted Roboflow Inference server (`inference server start`).
VITE_ROBOFLOW_INFERENCE_URL=http://localhost:9001

# How the browser sends the key on the non-proxied runtimes.
# `header` sends Authorization: Bearer; `query` uses the legacy ?api_key=.
VITE_ROBOFLOW_API_KEY_TRANSPORT=header

# --- Active learning ---------------------------------------------------------
# Push low-confidence inspection frames back into a Roboflow project for
# labelling and retraining.
VITE_ROBOFLOW_ACTIVE_LEARNING=false
VITE_ROBOFLOW_DATASET_PROJECT=
